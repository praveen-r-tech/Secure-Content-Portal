# Backend API base URL. Leave empty in development:
# Vite proxies /api to the backend (see vite.config.js).
# In production set this to the deployed API URL, e.g. https://your-api.onrender.com/api
VITE_API_BASE_URL=

# Auth0 (Phase 2)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
# Must match AUTH0_AUDIENCE in server/.env (the userinfo audience).
VITE_AUTH0_AUDIENCE=https://your-tenant.auth0.com/userinfo