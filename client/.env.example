# Backend API base URL. Leave empty in development:
# Vite proxies /api to the backend (see vite.config.js).
# In production set this to the deployed API URL, e.g. https://your-api.onrender.com/api
VITE_API_BASE_URL=

# Google Cloud OAuth (Google Identity Services)
# Get this from Google Cloud Console > APIs & Services > Credentials
# Create an "OAuth 2.0 Client ID" (Web application type)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com