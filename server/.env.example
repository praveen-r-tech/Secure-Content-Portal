# Express
PORT=5000

# MongoDB Atlas (Phase 2)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/secure-content-portal

# Auth0 (Phase 2)
# AUTH0_AUDIENCE uses the tenant's /userinfo audience so the backend can
# fetch the user's email/name from https://your-tenant.auth0.com/userinfo.
# It must match VITE_AUTH0_AUDIENCE in client/.env.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-tenant.auth0.com/userinfo
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Comma-separated emails granted the admin role.
# e.g. ADMIN_EMAILS=you@gmail.com
ADMIN_EMAILS=admin@example.com

# Cloudinary (used from Phase 3 onward)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173