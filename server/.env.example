# Express
PORT=5000

# MongoDB Atlas (used from Phase 2 onward)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/secure-content-portal

# Auth0 (used from Phase 2 onward)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://secure-content-portal-api
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Cloudinary (used from Phase 3 onward)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173